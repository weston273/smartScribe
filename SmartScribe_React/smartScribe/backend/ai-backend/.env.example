# Ollama Cloud direct API. Configure the real key in Render, never in frontend code.
OLLAMA_API_KEY=

# Optional cloud model override. Defaults to gemma4:31b-cloud.
OLLAMA_MODEL=gemma4:31b-cloud

# Optional model for the existing ultralong task; defaults to a 1M-context cloud model.
OLLAMA_LONG_CONTEXT_MODEL=nemotron-3-nano:30b-cloud

# Existing Deepgram transcription credential.
DEEPGRAM_API_KEY=

# Optional local server port; Render provides PORT automatically.
PORT=3001
